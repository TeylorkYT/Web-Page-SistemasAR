[Unit]
Description=Servicio Backend FastAPI - SistemasAR Mesa de Ayuda
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=sistemasar
Group=sistemasar
WorkingDirectory=/var/www/sistemasar/backend

# Archivo de variables de entorno de producción
EnvironmentFile=/var/www/sistemasar/backend/.env

# Ejecutable en entorno virtual con 2 workers asíncronos para Hostinger VPS (KVM 1)
ExecStart=/var/www/sistemasar/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips="127.0.0.1" \
    --log-config /var/www/sistemasar/backend/log_conf.json

# Política de reinicio ante caídas
Restart=always
RestartSec=5s

# Seguridad del proceso (Sandboxing Systemd)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/sistemasar/backend/uploads

# Límites de descriptores de archivo
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
