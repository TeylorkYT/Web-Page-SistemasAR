# Entorno: development | production | test
ENV=development

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sistemas_ar
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
TEST_DB_HOST=
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=
TEST_DB_NAME=sistemas_ar_test
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173

# Correo SMTP (opcional en desarrollo; si SMTP_HOST está vacío, el correo se omite)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soporte@sistemasar.net
SMTP_TLS=true

